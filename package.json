{
  "name": "app-builder-docfx",
  "version": "1.0.0",
  "description": "Documentation generator for App Builder.",
  "scripts": {
    "start": "gulp serve",
    "build": "gulp build",
    "build-staging": "set NODE_ENV=staging && gulp build",
    "build-production": "set NODE_ENV=production && gulp build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "dotnet tool restore",
    "lint:md": "markdownlint \"**/*.md\" --config .markdownlint.json",
    "lint:md:en": "markdownlint \"en/**/*.md\" --config .markdownlint.json",
    "lint:md:jp": "markdownlint \"jp/**/*.md\" --config .markdownlint.json",
    "lint:md:fix": "markdownlint \"**/*.md\" --config .markdownlint.json --fix",
    "spellcheck": "cspell \"en/**/*.md\"",
    "spellcheck:jp": "cspell \"jp/**/*.md\"",
    "verify": "npm run spellcheck && npm run lint:md:en",
    "verify:jp": "npm run spellcheck:jp && npm run lint:md:jp",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:local":  "node scripts/generate-changelog.mjs --host https://localhost:44381"
  },
  "author": "Infragistics",
  "license": "ISC",
  "dependencies": {
    "igniteui-docfx-template": "3.9.3",
    "natives": "^1.1.6",
    "require-or-import": "0.1.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "cspell": "^8.0.0",
    "del": "^5.1.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-dart-sass": "^1.0.2",
    "gulp-file-include": "^2.1.1",
    "gulp-replace": "^1.0.0",
    "gulp-shell": "^0.7.1",
    "markdownlint-cli": "^0.37.0",
    "slash": "^3.0.0"
  }
}
